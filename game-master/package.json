{
  "name": "game-master",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bdd": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "factory:sync": "node scripts/sync-factory.mjs",
    "factory:check": "node scripts/sync-factory.mjs --check",
    "verify": "npm run typecheck && npm test && npm run test:bdd && npm run test:arch && npm run factory:check"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
