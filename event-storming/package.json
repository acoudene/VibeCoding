{
  "name": "event-storming",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tests/workers/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test --grep-invert @perf",
    "test:e2e:perf": "playwright test --grep @perf",
    "test:bdd": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "factory:sync": "node scripts/sync-factory.mjs",
    "factory:check": "node scripts/sync-factory.mjs --check",
    "verify": "npm run typecheck && npm test && npm run test:workers && npm run test:bdd && npm run test:arch && npm run factory:check",
    "dev": "vite",
    "build": "vite build && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261012.1": true
  }
}
